# Optional Firebase overrides.
# The app already ships with the LOCK IN Firebase project configured, so this
# file is only needed if you fork the app or point it at another project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# All data lives under workspaces/{VITE_WORKSPACE_ID}
# Change this to a value you also allow in firestore.rules.
VITE_WORKSPACE_ID=lock-in-personal

# Optional local development. Connect the app to the Firestore emulator
# (127.0.0.1:8080) instead of the live project. Never use in production.
# VITE_USE_FIREBASE_EMULATOR=true
